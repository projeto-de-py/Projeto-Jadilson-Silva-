# Copie este arquivo para .env e ajuste os valores.

# Ambiente: "development" (padrao) ou "production".
# Em production a API exige segredo JWT forte + cookie Secure e desativa /docs.
APP_ENV=development

# Banco de dados MySQL (crie antes: CREATE DATABASE advocacia CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@localhost:3306/advocacia?charset=utf8mb4

# Segredo do JWT - OBRIGATORIO e forte em producao (min 32 bytes aleatorios):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-bem-grande
JWT_EXPIRE_MINUTES=480

# Cookie de sessao (o JWT vai em cookie HttpOnly, invisivel para o JS)
AUTH_COOKIE_NAME=jadilson_token
AUTH_COOKIE_SECURE=false   # true em producao (exige HTTPS) - OBRIGATORIO em production
AUTH_COOKIE_SAMESITE=lax   # "lax" ou "strict"

# Senha inicial do Admin criada pelo seed (python -m app.seed).
# Se vazio, o seed gera uma senha aleatoria forte e imprime uma unica vez.
# ADMIN_SENHA_INICIAL=AlgumaSenhaForteParaDev

# Confia no X-Forwarded-For para o IP real (so ligue ATRAS de um proxy de confianca,
# senao um atacante pode falsificar o header e escapar do rate limit por IP)
TRUST_PROXY_HEADERS=false

# Rate limit do login (janela deslizante de 5 min, em memoria)
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_LOGIN_EMAIL=5
RATE_LIMIT_JANELA_SEGUNDOS=300

# Origens liberadas para o frontend (Vite)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
