# Copie este arquivo para .env e ajuste os valores.

# Ambiente: "development" (padrao) ou "production".
# Em production a API exige segredo JWT forte + cookie Secure e desativa /docs.
APP_ENV=development

# Banco de dados MySQL (crie antes: CREATE DATABASE advocacia CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@localhost:3306/advocacia?charset=utf8mb4

# Segredo do JWT - OBRIGATORIO e forte em producao (min 32 bytes aleatorios):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-bem-grande
JWT_EXPIRE_MINUTES=480

# Cookie de sessao (o JWT vai em cookie HttpOnly, invisivel para o JS)
AUTH_COOKIE_NAME=jadilson_token
AUTH_COOKIE_SECURE=false   # true em producao (exige HTTPS) - OBRIGATORIO em production
AUTH_COOKIE_SAMESITE=lax   # "lax" ou "strict"

# Senha inicial do Admin criada pelo seed (python -m app.seed).
# Se vazio, o seed gera uma senha aleatoria forte e imprime uma unica vez.
# ADMIN_SENHA_INICIAL=AlgumaSenhaForteParaDev

# Conta do advogado principal: o seed provisiona esta conta com a
# permissao administrativa (campo `administrador`). Nenhum usuario pode
# escolher ser administrador pelo cadastro ou pelo login.
ADMIN_EMAIL=admin@jadilson.adv

# Confia no X-Forwarded-For para o IP real (so ligue ATRAS de um proxy de confianca,
# senao um atacante pode falsificar o header e escapar do rate limit por IP)
TRUST_PROXY_HEADERS=false

# Rate limit do login (janela deslizante de 5 min, em memoria)
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_LOGIN_EMAIL=5
RATE_LIMIT_JANELA_SEGUNDOS=300

# Origens liberadas para o frontend (Vite)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# IA (ver app/ia): "simulado" nao chama servico externo; "openrouter" usa o modelo Google gratuito
IA_PROVEDOR=simulado

# ---- IA real: OpenRouter + modelo gratuito do Google ----
# 1) Crie uma chave em https://openrouter.ai/keys  2) Cole abaixo  3) Troque IA_PROVEDOR para openrouter
# IA_PROVEDOR (ou LLM_PROVIDER): simulado | openrouter
OPENROUTER_API_KEY=
# Modelo gratuito do Google (a lista muda; confira em https://openrouter.ai/models?q=google%20free):
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Reservas (se o principal estiver saturado, o OpenRouter tenta estes, na ordem):
# OPENROUTER_MODELOS_ALTERNATIVOS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free

# ---- ZapSign (assinatura eletronica) ----
# ZAPSIGN_API_TOKEN=
# Segredo compartilhado do webhook: configure no painel do ZapSign um header com este valor
# (nome do header em ZAPSIGN_WEBHOOK_HEADER, padrao X-Zapsign-Secret)
# ZAPSIGN_WEBHOOK_SECRET=

# ---- Asaas (cobranca de honorarios) ----
# O padrao e o SANDBOX. Em producao use https://api.asaas.com/v3
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
# Token do webhook: o mesmo valor configurado no Asaas (chega no header asaas-access-token)
# ASAAS_WEBHOOK_TOKEN=

# ---- DataJud (andamentos de processos, CNJ) ----
# Chave PUBLICA do CNJ (pode ser trocada por eles): https://datajud-wiki.cnj.jus.br/api-publica/acesso
# DATAJUD_API_KEY=

# ---- Consultas publicas (BrasilAPI e Banco Central nao usam chave) ----
# CONSULTAS_LIMITE_MINUTO=60
