# Apenas opcoes nao sensiveis para acrescentar manualmente ao backend/.env.
# Nao substituir o .env existente nem copiar a configuracao JWT legada.
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=10
MYSQL_WRITE_TIMEOUT=10
# CA confiavel; quando definida, verifica certificado E identidade do host.
# MYSQL_SSL_CA=/caminho/absoluto/ca.pem
# Em producao com MySQL remoto, MYSQL_SSL_CA e obrigatoria.
